FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080 PRODUCTION_EXECUTION=false
WORKDIR /app
RUN useradd --create-home --uid 10001 sentinelops
COPY pyproject.toml ./
COPY backend ./backend
COPY services ./services
RUN pip install --no-cache-dir .
USER sentinelops
EXPOSE 8080
CMD ["sh", "-c", "uvicorn --app-dir services/mcp-server main:app --host 0.0.0.0 --port ${PORT}"]
